# Copy to .env.local for development. Both values are public by design: the publishable key
# can only do what the database's row-level security allows.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: the live address, for canonical links and absolute social-image URLs.
VITE_SITE_URL=https://your-domain.co.za
